generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PaymentType {
  CREDIT_CARD
  BANK_ACCOUNT
  OTHER
}

enum Currency {
  TWD
  USD
}

enum BillingCycle {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// Subscription category, e.g. membership, telecom, insurance.
model Category {
  id            Int            @id @default(autoincrement())
  name          String         @unique @db.VarChar(50)
  icon          String?        @db.VarChar(16)
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  subscriptions Subscription[]

  @@map("categories")
}

/// Where the money is charged from, e.g. a specific credit card or bank account.
model PaymentMethod {
  id            Int            @id @default(autoincrement())
  type          PaymentType
  name          String         @db.VarChar(100)
  note          String?        @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at")
  subscriptions Subscription[]

  @@unique([type, name])
  @@map("payment_methods")
}

/// A recurring payment item. `amount` is the current amount, applying from the day after
/// the latest `amountPeriods` end date (or from `startDate` when there are none).
/// `amortize` spreads each YEARLY charge over the 12 months before it as a monthly reserve.
model Subscription {
  id              Int                        @id @default(autoincrement())
  name            String                     @db.VarChar(100)
  categoryId      Int                        @map("category_id")
  paymentMethodId Int                        @map("payment_method_id")
  /// First day the subscription charges; nothing is charged before it.
  startDate       DateTime                   @map("start_date") @db.Date
  /// Last day of the contract, if any. It still charges on this day; nothing is charged after it.
  contractEndDate DateTime?                  @map("contract_end_date") @db.Date
  currency        Currency                   @default(TWD)
  amount          Decimal                    @db.Decimal(12, 2)
  amortize        Boolean                    @default(false)
  note           String?                    @db.VarChar(255)
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")
  category        Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod              @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  schedules       BillingSchedule[]
  amountPeriods   SubscriptionAmountPeriod[]

  @@index([categoryId])
  @@index([paymentMethodId])
  @@map("subscriptions")
}

/// A past amount of a subscription. It applies up to and including `endDate`, starting the
/// day after the previous period's end date (or the subscription's `startDate` for the first).
model SubscriptionAmountPeriod {
  id             Int          @id @default(autoincrement())
  subscriptionId Int          @map("subscription_id")
  amount         Decimal      @db.Decimal(12, 2)
  endDate        DateTime     @map("end_date") @db.Date
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, endDate])
  @@map("subscription_amount_periods")
}

/// One billing rule of a subscription. Which day fields are used depends on `cycle`:
/// DAILY uses none, WEEKLY uses dayOfWeek (0 = Sunday), MONTHLY uses dayOfMonth,
/// YEARLY uses month + dayOfMonth.
model BillingSchedule {
  id             Int          @id @default(autoincrement())
  subscriptionId Int          @map("subscription_id")
  cycle          BillingCycle
  dayOfWeek      Int?         @map("day_of_week") @db.TinyInt
  dayOfMonth     Int?         @map("day_of_month") @db.TinyInt
  month          Int?         @db.TinyInt
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("billing_schedules")
}

/// Published exchange rate of one day, as `quote` per 1 `base` (e.g. TWD per 1 USD). A cache of
/// public data, so it is left out of backups.
model ExchangeRate {
  base  Currency
  quote Currency
  date  DateTime @db.Date
  rate  Decimal  @db.Decimal(14, 6)

  @@id([base, quote, date])
  @@map("exchange_rates")
}

/// When a currency pair's rates of one year were last fetched. Days without a publication have no
/// rate row, so this is what tells "not published" apart from "not fetched yet". `complete` marks a
/// year whose rates were fetched after it ended, so it never needs fetching again.
model ExchangeRateSync {
  base     Currency
  quote    Currency
  year     Int      @db.SmallInt
  syncedOn DateTime @map("synced_on") @db.Date
  complete Boolean  @default(false)

  @@id([base, quote, year])
  @@map("exchange_rate_syncs")
}
