# Port the app listens on (Docker Compose only; the container uses host networking)
APP_PORT=3000
# Time zone used in log timestamps (Docker Compose only)
TZ=Asia/Taipei
# User/group IDs the container runs as; they must be able to write LOG_HOST_DIR (Docker Compose only).
# Use a dedicated low-privilege host account and look its IDs up with `id <account>`.
APP_UID=1000
APP_GID=1000

# MySQL connection string used by Prisma.
# Under Docker Compose it reaches the app as the `database_url` Docker secret (mounted at
# /run/secrets/database_url, read via DATABASE_URL_FILE), not as an environment variable, so the
# password doesn't show up in `docker inspect`; keep this line, since the secret is sourced from it.
DATABASE_URL="mysql://user:password@localhost:3306/koukou"

# Logging (server only). Records always go to the console; these settings control the log file.
# Write records to a file as well: true/false
LOG_FILE_ENABLED=true
# Host directory mounted as the container's log directory (Docker Compose only)
LOG_HOST_DIR=./logs
# Active log file; relative paths resolve from the project root.
# Ignored by Docker Compose, which fixes it to /app/logs/koukou.log inside LOG_HOST_DIR.
LOG_FILE_PATH=koukou.log
# Lowest level written: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
# Rotate the file (to e.g. koukou-20260829T125438.log) once it would exceed this size in MB
LOG_MAX_FILE_SIZE_MB=10
# Most log files kept, including the active one; the oldest are deleted first
LOG_MAX_FILES=5

# LINE Messaging API for reminder messages (optional; nothing is sent while either is empty).
# Channel access token (long-lived) from the LINE Developers Console, Messaging API tab.
# Under Docker Compose both reach the app as Docker secrets (mounted under /run/secrets/, read via
# LINE_CHANNEL_ACCESS_TOKEN_FILE / LINE_USER_ID_FILE), like DATABASE_URL; keep these lines, since the
# secrets are sourced from them.
LINE_CHANNEL_ACCESS_TOKEN=
# Your own user ID ("U" followed by 32 hex characters), shown at the bottom of the channel's Basic settings tab.
LINE_USER_ID=
